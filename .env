# ===========================================================================
# СКАНЕР СВЕЧЕЙ BYBIT (чаты SCAN_A / SCAN_B)
# Не слушают telegram-каналы, сами опрашивают рынок бессрочных фьючерсов.
#
# Раньше эти чаты назывались CHAT_G / CHAT_H. Имена освобождены под WAE-чаты,
# где буквы G/H/I стояли исторически. A/B соответствуют тому, как заказчик
# называет их в ТЗ сканера ("CHAT A" / "CHAT B").
# ===========================================================================

# Общие настройки сканирования (влияют на ОБЕ группы: свечные и WAE)
SCAN_VOLUME=10000000
SCAN_MINTIME=60
SCAN_DUPLICATE=300

# Темп запросов к бирже. 40 req/s втрое ниже лимита Bybit (600 за 5с на IP).
# Параллельность выше 20 замедляет: биржа начинает придерживать ответы.
SCAN_REQ_PER_SEC=40
SCAN_CONCURRENCY=20

# --- SCAN_A (в ТЗ заказчика это "CHAT A", бывший CHAT_G) ---
SCAN_A_CHAT_ID=-5596109362
SCAN_A_RSI=off
SCAN_A_CANDLE_COLOUR=green
SCAN_A_CANDLE_TIMEFRAME=15m
SCAN_A_CANDLE_SIZE=10
SCAN_A_PREVIOS_CANDLE=off
SCAN_A_CHANGE=1.5
SCAN_A_PERIOD_INFO=15D
SCAN_A_PERIOD_CANDLES=3

# --- SCAN_B (в ТЗ заказчика это "CHAT B", бывший CHAT_H) ---
SCAN_B_CHAT_ID=-5421098374
SCAN_B_RSI=off
SCAN_B_CANDLE_COLOUR=red
SCAN_B_CANDLE_TIMEFRAME=15m
SCAN_B_CANDLE_SIZE=10
SCAN_B_PREVIOS_CANDLE=off
SCAN_B_CHANGE=2.5
SCAN_B_PERIOD_INFO=15D
SCAN_B_PERIOD_CANDLES=3


# ===========================================================================
# WAE-ЧАТЫ (Waddah Attar Explosion) — чаты 7/8/9, CHAT_G / CHAT_H / CHAT_I
#
# Имена переменных те же, что в старой версии бота, — настройки переносятся
# копированием. Единственный новый ключ: CHAT_G_CHAT_ID (раньше id был зашит
# в config.py числом).
#
# Работают в том же цикле сканирования, что и SCAN_A/SCAN_B, но фильтруют не
# свечи, а последовательность баров индикатора WAE.
#
# Оборот, окно дедупликации и таймфрейм по умолчанию берутся из ОБЩИХ настроек
# в начале файла: MIN_VOLUME_, SEND_DUPLICATE_PAIR_SECONDS, TIMEFRAME_GLOBAL.
# Частота опроса — общая со сканером (SCAN_MINTIME).
#
# Как читать настройку последовательности на примере CHAT_G:
#   ALLTIME_G=2      всего баров в последовательности
#   Time_G_1=SELL 10 бары кроме последнего: цвет и минимальный отрыв от
#                    explosion line в %
#   COLOUR_G=SELL    цвет ПОСЛЕДНЕГО (текущего) бара
#   POWER_G=45       минимальный отрыв последнего бара в %
# Итоговая проверка: [{SELL: 10}, {SELL: 45}] — слева старый бар, справа текущий.
#
# Фильтр по изменению цены за период:
#   CHANGE_G_IS=1        включить (0 — только показывать, не фильтровать)
#   CHANGE_G_TIMEFRAIM   период дневными свечами: 15d = 15 дневных свечей
#   CHANGE_G=0           минимальное изменение за период в %
#
# ВНИМАНИЕ: id стоят в 0 — чаты выключены. Впишите свои, чтобы включить.
# Боевые id из старой версии (НЕ включайте без ведома заказчика):
#   CHAT_G=-1003691061774  CHAT_H=-1003867754271  CHAT_I=-1003797981380
# ===========================================================================

# --- CHAT_G (чат 7) ---
CHAT_G_CHAT_ID=0
CHAT_G_TIMEFRAME_GLOBAL=1h
COLOUR_G=SELL
POWER_G=45
ALLTIME_G=2
Time_G_1=SELL 10
CHANGE_G=0
CHANGE_G_TIMEFRAIM=15d
CHANGE_G_IS=1

# --- CHAT_H (чат 8) ---
CHAT_H_CHAT_ID=0
CHAT_H_TIMEFRAME_GLOBAL=4h
COLOUR_H=SELL
POWER_H=10
ALLTIME_H=2
Time_H_1=SELL 10
CHANGE_H=0
CHANGE_H_TIMEFRAIM=1d
CHANGE_H_IS=1

# --- CHAT_I (чат 9) ---
CHAT_I_CHAT_ID=0
CHAT_I_TIMEFRAME_GLOBAL=1d
COLOUR_I=SELL
POWER_I=10
ALLTIME_I=3
Time_I_1=BUY -90
Time_I_2=BUY -90
CHANGE_I=0
CHANGE_I_TIMEFRAIM=1d
CHANGE_I_IS=1
