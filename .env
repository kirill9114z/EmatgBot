# ===========================================================================
# СКАНЕР РЫНКА BYBIT (чаты CHAT_G / CHAT_H)
# Не слушают telegram-каналы, сами опрашивают рынок бессрочных фьючерсов.
# ===========================================================================

# Общие настройки сканирования (влияют на обе группы)
SCAN_VOLUME=10000000
SCAN_MINTIME=60
SCAN_DUPLICATE=300

# --- CHAT_G (в ТЗ заказчика это "CHAT A") ---
CHAT_G_CHAT_ID=-5596109362
CHAT_G_RSI=off
CHAT_G_CANDLE_COLOUR=green
CHAT_G_CANDLE_TIMEFRAME=15m
CHAT_G_CANDLE_SIZE=10
CHAT_G_PREVIOS_CANDLE=off
CHAT_G_CHANGE=1.5
CHAT_G_PERIOD_INFO=15D
CHAT_G_PERIOD_CANDLES=3

# --- CHAT_H (в ТЗ заказчика это "CHAT B") ---
CHAT_H_CHAT_ID=-5421098374
CHAT_H_RSI=off
CHAT_H_CANDLE_COLOUR=red
CHAT_H_CANDLE_TIMEFRAME=15m
CHAT_H_CANDLE_SIZE=10
CHAT_H_PREVIOS_CANDLE=off
CHAT_H_CHANGE=2.5
CHAT_H_PERIOD_INFO=15D
CHAT_H_PERIOD_CANDLES=3


# ===========================================================================
# WAE-ЧАТЫ (Waddah Attar Explosion) — чаты 7/8/9
#
# Работают в том же цикле сканирования, что и CHAT_G/CHAT_H, но фильтруют не
# свечи, а последовательность баров индикатора WAE.
#
# Оборот, окно дедупликации и таймфрейм по умолчанию берутся из ОБЩИХ настроек
# в начале файла: MIN_VOLUME_, SEND_DUPLICATE_PAIR_SECONDS, TIMEFRAME_GLOBAL.
# Частота опроса — общая со сканером (SCAN_MINTIME).
#
# Как читать настройку последовательности на примере WAE_G:
#   ALLTIME_G=2      всего баров в последовательности
#   Time_G_1=SELL 10 бары кроме последнего: цвет и минимальный отрыв от
#                    explosion line в %
#   COLOUR_G=SELL    цвет ПОСЛЕДНЕГО (текущего) бара
#   POWER_G=45       минимальный отрыв последнего бара в %
# Итоговая проверка: [{SELL: 10}, {SELL: 45}] — слева старый бар, справа текущий.
#
# ВНИМАНИЕ: id стоят в 0 — чаты выключены. Впишите свои, чтобы включить.
# Боевые id из старой версии (НЕ включайте без ведома заказчика):
#   WAE_G=-1003691061774  WAE_H=-1003867754271  WAE_I=-1003797981380
# ===========================================================================

# --- WAE_G (в старой версии CHAT_G, чат 7) ---
WAE_G_CHAT_ID=0
WAE_G_TIMEFRAME=1h
WAE_G_PERIOD_INFO=15d
ALLTIME_G=2
Time_G_1=SELL 10
COLOUR_G=SELL
POWER_G=45

# --- WAE_H (в старой версии CHAT_H, чат 8) ---
WAE_H_CHAT_ID=0
WAE_H_TIMEFRAME=4h
WAE_H_PERIOD_INFO=1d
ALLTIME_H=2
Time_H_1=SELL 10
COLOUR_H=SELL
POWER_H=10

# --- WAE_I (в старой версии CHAT_I, чат 9) ---
WAE_I_CHAT_ID=0
WAE_I_TIMEFRAME=1d
WAE_I_PERIOD_INFO=1d
ALLTIME_I=3
Time_I_1=BUY -90
Time_I_2=BUY -90
COLOUR_I=SELL
POWER_I=10
